{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/docs/index.html" },
    { "source": "/face_lab", "destination": "/docs/face_lab.html" },
    { "source": "/face_lab.html", "destination": "/docs/face_lab.html" },
    { "source": "/(.*)", "destination": "/docs/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
